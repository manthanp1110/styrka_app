# Firebase Configuration (Create a project at https://console.firebase.google.com and paste keys here)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Render Live Telemetry Server
EXPO_PUBLIC_BACKEND_URL=https://styrka-app.onrender.com

# Mappls / MapmyIndia Keys
MAPPLS_API_KEY=
EXPO_PUBLIC_MAPPLS_API_KEY=
EXPO_PUBLIC_MAPPLS_ATLAS_REST_API_KEY=
EXPO_PUBLIC_MAPPLS_ATLAS_MAP_SDK_KEY=
EXPO_PUBLIC_MAPPLS_ATLAS_CLIENT_ID=

# Google Maps APIs
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=
EXPO_PUBLIC_GOOGLE_GEOCODING_API_KEY=
