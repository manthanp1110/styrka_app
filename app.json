{
  "expo": {
    "name": "Styrka",
    "slug": "Styrka",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Styrka requires continuous background location access to track field journeys and calculate route compliance.",
        "NSLocationWhenInUseUsageDescription": "Styrka requires background location access to track field journeys."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.manthanp_2811.styrka"
    },
    "extra": {
      "eas": {
        "projectId": "714587b8-0d06-4ade-8c04-6df9c49db5ea"
      }
    },
    "owner": "manthanp_2811",
    "plugins": [
      "@maplibre/maplibre-react-native"
    ]
  }
}
