{
  "expo": {
    "name": "Styrka",
    "slug": "Styrka",
    "version": "1.0.0",
    "icon": "./styrka-icon.png",
    "splash": {
      "image": "./styrka-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.manthanp2811.styrka",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Styrka requires continuous background location access to track field journeys and calculate route compliance.",
        "NSLocationWhenInUseUsageDescription": "Styrka requires background location access to track field journeys."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./styrka-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "package": "com.manthanp_2811.styrka"
    },
    "extra": {
      "eas": {
        "projectId": "714587b8-0d06-4ade-8c04-6df9c49db5ea"
      }
    },
    "owner": "manthanp_2811",
    "plugins": [
      "@maplibre/maplibre-react-native"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/714587b8-0d06-4ade-8c04-6df9c49db5ea"
    }
  }
}
